          RowBox[{"DB", "*", "cB0", "*", 
           RowBox[{"MBA", "[", "k", "]"}]}], ",", 
          RowBox[{"DB", "*", "cB0", "*", 
           RowBox[{"MBB", "[", "k", "]"}]}]}], "}"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"eigs", "[", "k_", "]"}], ":=", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{"Jmat", "[", "k", "]"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Sigma]1", 
       RowBox[{"(", "k", ")"}]}], ",", 
      RowBox[{"\[Sigma]2", 
       RowBox[{"(", "k", ")"}]}]}], "}"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "\[LongDash]", "\[LongDash]", "\[LongDash]", "\[LongDash]", "Bestimme", ",", 
