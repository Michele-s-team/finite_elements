      RowBox[{"(", "k", ")"}]}], "\[LongDash]", "\[LongDash]", "\[LongDash]", 
     "\[LongDash]"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Evaluate", "[", 
      RowBox[{"eigs", "[", "k", "]"}], "]"}], ",", 
     RowBox[{"{", 
