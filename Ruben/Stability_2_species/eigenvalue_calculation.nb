      RowBox[{"(", "k", ")"}], " ", "und", " ", "Eigenwerte", " ", "\[Sigma]", 
      RowBox[{"(", "k", ")"}]}], "\[LongDash]", "\[LongDash]", "\[LongDash]", 
     "\[LongDash]"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Jmat", "[", "k_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"k", "^", "2"}]}], "*", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"DA", "*", "cA0", "*", 
           RowBox[{"MAA", "[", "k", "]"}]}], ",", 
          RowBox[{"DA", "*", "cA0", "*", 
           RowBox[{"MAB", "[", "k", "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
