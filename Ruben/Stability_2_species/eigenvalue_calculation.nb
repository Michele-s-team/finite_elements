   RowBox[{
    RowBox[{"kappaAB", "=", "0.1"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"Gradientenkopplung", " ", "\[Kappa]_", 
     RowBox[{"{", "AB", "}"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"DA", "=", "1.0"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"Diffusionskonstante", " ", "A"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"DB", "=", "1.0"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"Diffusionskonstante", " ", "B"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
