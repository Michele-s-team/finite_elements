      "gr\[ODoubleDot]\[SZ]ten", " ", "Wachstumsrate"}], "\[LongDash]", "\[LongDash]",
      "\[LongDash]", "\[LongDash]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dispMax", "[", "k_", "]"}], ":=", 
     RowBox[{"Max", "[", 
      RowBox[{"eigs", "[", "k", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Suche", " ", "nur"}], ",", 
