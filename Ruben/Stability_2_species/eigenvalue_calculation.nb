     RowBox[{"Instabilit\[ADoubleDot]t", " ", "vorliegt"}], "\[LongDash]", "\[LongDash]",
      "\[LongDash]", "\[LongDash]"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"spinodalExists", "=", 
     RowBox[{
      RowBox[{"fAA", "<", "0"}], "||", 
      RowBox[{"fBB", "<", "0"}], "||", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"fAA", " ", "fBB"}], "-", 
         RowBox[{"fAB", "^", "2"}]}], ")"}], "<", "0"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", "spinodalExists"}], ",", 
      RowBox[{
       RowBox[{
       "Print", 
        "[", "\"\<Keine Spinodalinstabilit\[ADoubleDot]t (alle zweiten \
Ableitungen positiv).\>\"", "]"}], ";"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\[LongDash]", "\[LongDash]", "\[LongDash]", "\[LongDash]", 
     RowBox[{
     "k\:2011Bereich", " ", "f\[UDoubleDot]r", " ", "Plot", " ", 
      "festlegen"}], "\[LongDash]", "\[LongDash]", "\[LongDash]", 
     "\[LongDash]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Wenn", " ", "Instabilit\[ADoubleDot]t"}], ",", 
     RowBox[{
      RowBox[{"nutze", " ", "kritische", " ", "Wellenzahl"}], ";", 
      RowBox[{"sonst", " ", "fixe", " ", "Obergrenze"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kcrit", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"fAA", "<", "0"}], ",", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"-", "fAA"}], "*", 
         RowBox[{"sigma", "/", "kappaAA"}]}], "]"}], ",", "1.0"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"kPlotMax", "=", 
