      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "cA0"}], "+", 
        RowBox[{"B2AA", "/", "sigma"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fBB", "=", 
     RowBox[{"kBT", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "/", "cB0"}], "+", 
        RowBox[{"B2BB", "/", "sigma"}]}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fAB", "=", 
     RowBox[{"kBT", "*", 
      RowBox[{"(", 
       RowBox[{"B2AB", "/", "sigma"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\[LongDash]", "\[LongDash]", "\[LongDash]", "\[LongDash]", "M", "\[Hyphen]", 
     RowBox[{"Matrix", " ", "als", " ", "Funktionen", " ", "von", " ", "k"}], 
     "\[LongDash]", "\[LongDash]", "\[LongDash]", "\[LongDash]"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MAA", "[", "k_", "]"}], ":=", 
     RowBox[{"fAA", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"kappaAA", "/", "sigma"}], ")"}], "*", 
       RowBox[{"k", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MBB", "[", "k_", "]"}], ":=", 
