       RowBox[{"Print", "[", 
        RowBox[{"\"\<lambda_max  = \>\"", ",", 
         RowBox[{"N", "[", 
          RowBox[{"lambdaMax", ",", "6"}], "]"}]}], "]"}], ";"}]}], "]"}], 
