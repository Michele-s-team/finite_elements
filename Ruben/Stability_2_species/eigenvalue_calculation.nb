     RowBox[{"(*", "Beschriftungen", "*)"}], 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"FontSize", "->", "14"}], "]"}]}], ",", 
     RowBox[{"(*", "Schriftgr\[ODoubleDot]\[SZ]e", "*)"}], 
     RowBox[{"FrameTicksStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"FontSize", "->", "12"}], "]"}]}], ",", 
