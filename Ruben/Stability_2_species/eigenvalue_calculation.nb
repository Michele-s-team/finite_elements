          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"kPlotMax", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"kmaxVal", "=", 
        RowBox[{"k", "/.", " ", 
         RowBox[{"sol", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"extrahiere", " ", "k"}], "\[RightArrow]", "kmaxVal"}], 
        "*)"}], 
       RowBox[{"lambdaMax", "=", 
        RowBox[{"2", "*", 
