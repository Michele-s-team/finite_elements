      RowBox[{
       RowBox[{"(", 
        RowBox[{"kappaBB", "/", "sigma"}], ")"}], "*", 
       RowBox[{"k", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MAB", "[", "k_", "]"}], ":=", 
     RowBox[{"fAB", "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"kappaAB", "/", "sigma"}], ")"}], "*", 
       RowBox[{"k", "^", "2"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MBA", "[", "k_", "]"}], ":=", 
     RowBox[{"MAB", "[", "k", "]"}]}], ";"}], "  ", 
   RowBox[{"(*", "symmetrisch", "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\[LongDash]", "\[LongDash]", "\[LongDash]", "\[LongDash]", 
