Out[114]= 
ClearAll[rB];
RA=1.0;kBT=1.0;cA0=1.0;cB0=1.0;
B2[i_,j_]:=(4 Pi/3)*(i+j)^3;
sigma[i_,j_]:=Pi*(i+j)^2;
M={{1+B2[RA,RA],B2[RA,rB]},{B2[RA,rB],1/cB0+B2[rB,rB]}};
eq=Det[M]==0;
sol=FindRoot[eq,{rB,0.5}];  (*Setze als Startwert z.B.0.5*)
rBcritAnalytisch=rB/. sol
Out[99]= -0.28101

In[100]:= F[cA_,cB_]:=Total[kBT (cA Log[cA/cA0]+cB Log[cB/cB0])+(kBT/(2 sigma[RA,RA])) B2[RA,RA] cA^2+(kBT/(2 sigma[rB,rB])) B2[rB,rB] cB^2+(kBT/(sigma[RA,rB])) B2[RA,rB] cA cB+(*ggf.Gradiententerm,wenn kappa0>0*)0];
{cAopt,cBopt}=Nest[Function[{cb},Module[{cA=cb[[;;nPts]],cB=cb[[nPts+1;;]]},gradA=D[F[cA,cB],cA];
gradB=D[F[cA,cB],cB];
Join[cA,cB]-0.01 Join[gradA,gradB]  (*Schrittweite anpassen*)]],Join[cAinit,cBinit],1000];
