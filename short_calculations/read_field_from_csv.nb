Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "1*^-3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"tf", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"i", "=", "1"}]}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "[", "f", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", "h"}], "]"}], "<", 
      "\[Epsilon]"}], ",", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"tf", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"f", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}],
   "\[IndentingNewLine]", "]"}]}], "Input",
