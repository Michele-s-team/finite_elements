 CellLabel->
  "In[358]:=",ExpressionUUID->"55fdd9d2-ea2c-441a-88e9-da1e2ac459e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"tf", ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"fexact", "[", 
      RowBox[{"x", ",", "h"}], "]"}], ",", 
