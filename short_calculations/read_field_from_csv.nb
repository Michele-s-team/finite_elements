  RowBox[{"read", " ", "scalar", " ", "field"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9699529481372766`*^9, 3.969952956961555*^9}},
 CellLabel->
  "In[331]:=",ExpressionUUID->"9390ee9c-c7e8-4004-b12b-bc4f3c958571"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "1*^-3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"tf", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"i", "=", "1"}]}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "[", "f", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "3"}], "]"}], "]"}], "-", "h"}], "]"}], "<", 
      "\[Epsilon]"}], ",", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"tf", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"f", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], "]"}]}],
   "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9699529576632833`*^9, 3.969952991034669*^9}, {
  3.969953061001109*^9, 3.9699530654820004`*^9}, {3.9699531195507307`*^9, 
  3.969953123046021*^9}, {3.9699711145304947`*^9, 3.969971122095852*^9}, {
