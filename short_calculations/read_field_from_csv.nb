Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", "1*^-3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"tv", "=", 
     RowBox[{"{", "}"}]}], ";", 
    RowBox[{"i", "=", "1"}]}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "[", "v", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "5"}], "]"}], "]"}], "-", "h"}], "]"}], "<", 
      "\[Epsilon]"}], ",", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"tv", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "4"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
