Cell[BoxData[{
 RowBox[{
  RowBox[{"ushape", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"x", "+", "y"}], ")"}]}], "]"}], ",", 
      RowBox[{"Cos", "[", 
       RowBox[{"4", " ", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"x", "+", "y"}], ")"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}]}], "]"}], "^", "2"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}]}], "]"}], "^", "2"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}]}], "]"}], "^", "2"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
          RowBox[{"x", "-", 
           RowBox[{"y", "^", "2"}]}], ")"}]}], "]"}], "^", "2"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"usquare", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"x", "+", "y"}], ")"}]}], "]"}], ",", 
      RowBox[{"Cos", "[", 
       RowBox[{"4", " ", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"x", "+", "y"}], ")"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}]}], "]"}], "^", "2"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}]}], "]"}], "^", "3"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}]}], "]"}], "^", "4"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "\[Pi]", 
         RowBox[{"(", 
