        RowBox[{"4", "\[Pi]", " ", 
         RowBox[{"x", "/", "L1"}]}], "]"}], "^", "2"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"6", "\[Pi]", " ", 
        RowBox[{"x", "/", "L1"}]}], "]"}], ",", 
