Cell[BoxData[
 RowBox[{
  RowBox[{"texact", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"x", " ", "+", " ", 
          RowBox[{"1.23", " ", "y"}]}], ")"}]}], "]"}], ",", 
      RowBox[{"Cos", "[", 
       RowBox[{"4", " ", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"x", " ", "-", " ", "y"}], ")"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"3", " ", "\[Pi]", " ", 
        RowBox[{"(", 
         RowBox[{"x", "+", 
          RowBox[{"y", "/", "2"}]}], ")"}]}], "]"}], ",", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "\[Pi]", 
        RowBox[{"(", 
         RowBox[{"x", "+", 
          RowBox[{"y", "^", "2"}]}], ")"}]}], "]"}]}], "}"}]}], 
   "}"}]}]], "Input",
