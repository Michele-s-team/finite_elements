 RowBox[{
  RowBox[{"plotdFdl\[Sigma]3dexact", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", " ", 
