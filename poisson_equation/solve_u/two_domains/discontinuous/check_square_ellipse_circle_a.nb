Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"plotexactshape", "=", 
   RowBox[{"Plot3D", "[", 
    RowBox[{
     RowBox[{"ushape", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "0", ",", "h"}], "}"}], ",", 
     RowBox[{"RegionFunction", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", 
             RowBox[{"c", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"y", "-", 
             RowBox[{"c", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "^", "2"}]}], "<", 
         RowBox[{"r", "^", "2"}]}]}], "]"}]}], ",", 
     RowBox[{"PlotRange", "->", "Full"}], ",", 
     RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], "\n"}]], "Input",
