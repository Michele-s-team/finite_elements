Cell[BoxData[
 RowBox[{
  RowBox[{"u1", "[", "x_", "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"2", "\[Pi]", " ", 
        RowBox[{"x", "/", "L"}]}], "]"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"4", "\[Pi]", " ", 
        RowBox[{"x", "/", "L"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", "\[Pi]", " ", 
         RowBox[{"x", "/", "L"}]}], "]"}], "^", "2"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"4", "\[Pi]", " ", 
         RowBox[{"x", "/", "L"}]}], "]"}], "^", "2"}], ",", 
      RowBox[{"Sin", "[", 
       RowBox[{"6", "\[Pi]", " ", 
        RowBox[{"x", "/", "L"}]}], "]"}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"6", "\[Pi]", " ", 
         RowBox[{"x", "/", "L"}]}], "]"}], "^", "2"}]}], "}"}]}], 
   "}"}]}]], "Input",
