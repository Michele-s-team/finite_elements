Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"t2d", "[", "x_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"2", "\[Pi]", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"x", "[", 
