Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"plotex\[Psi]", "=", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"l", "[", "x", "]"}], ",", 
      RowBox[{"norm", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"ArcTan", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"e", "[", "x", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"e", "[", "x", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], "-", 
        RowBox[{"\[Psi]0", "[", "x", "]"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "L"}], "}"}], ",", 
