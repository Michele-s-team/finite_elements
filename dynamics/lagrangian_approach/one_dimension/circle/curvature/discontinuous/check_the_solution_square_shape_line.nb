Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"IMPORTANT", ":", " ", 
    RowBox[{
    "to", " ", "compare", " ", "with", " ", "the", " ", "numerical", " ", 
     "solution"}]}], ",", " ", 
   RowBox[{"here", " ", "I", " ", "plot", " ", 
    RowBox[{"g", "[", "s", "]"}]}], ",", " ", 
   RowBox[{"H", "[", "s", "]"}], ",", " ", 
   RowBox[{
   "...", " ", "on", " ", "to", " ", "of", " ", "the", " ", "REFERENCE", " ", 
    "curve", " ", 
    RowBox[{"y", "[", "s", "]"}]}], ",", " ", 
   RowBox[{
   "not", " ", "on", " ", "top", " ", "of", " ", "the", " ", "current", " ", 
    RowBox[{"one", ".", " ", "In"}], " ", "fact"}], ",", " ", 
   RowBox[{"in", " ", "the", " ", "numerical", " ", "calculation", " ", "g"}],
    ",", " ", "H", ",", " ", 
   RowBox[{
    RowBox[{"...", ".", " ", "take"}], " ", "the", " ", "correct", " ", 
    "values", " ", "when", " ", "computed", " ", 
    RowBox[{"on", " ", "\\", "partial", " ", "\\", 
     RowBox[{"Omega", "^", "y_circle"}]}]}], ",", " ", 
   RowBox[{"not", " ", 
