      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], "/", 
   RowBox[{"Norm", "[", 
