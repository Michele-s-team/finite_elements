Cell[BoxData[{
 RowBox[{
  RowBox[{"y", "[", "t_", "]"}], ":=", 
  RowBox[{"c", "+", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", " ", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "\[Pi]", " ", "t"}], "]"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Pi]", " ", "t"}], "]"}]}], ")"}]}]}], ",", 
     RowBox[{"b", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", "\[Pi]", " ", "t"}], "]"}]}]}], "}"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"u", "[", "y_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d", " ", 
      RowBox[{"y", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", "d"}], " ", 
      RowBox[{"y", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "this", " ", "is", " ", "the", " ", "current", " ", "position", " ", 
    "vector"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"y", "[", "t", "]"}], "+", 
   RowBox[{"u", "[", 
    RowBox[{"y", "[", "t", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
