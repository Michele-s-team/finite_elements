Cell[BoxData[
 RowBox[{
  RowBox[{"v", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"2", "\[Pi]", " ", "x"}], "-", 
       RowBox[{"\[Pi]", " ", "y"}]}], "]"}], "*", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"2", "\[Pi]", " ", "y"}], "-", 
        RowBox[{"\[Pi]", " ", "x"}]}], "]"}], "^", "2"}]}], ",", 
    RowBox[{"Cos", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], ",", 
    RowBox[{"Sin", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", "-", "x"}], ")"}], "^", "2"}], "]"}]}], "}"}]}]], "Input",\

 CellChangeTimes->{{3.9661805686067533`*^9, 3.9661805788911552`*^9}, {
