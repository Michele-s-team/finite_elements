Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"The", " ", "condition", " ", 
     RowBox[{"P", "[", "L", "]"}]}], "==", 
    RowBox[{"0", " ", "has", " ", "multiple", " ", "solutions"}]}], "->", " ", 
   RowBox[{
    RowBox[{"we", " ", "pick", " ", "the", " ", "solution", " ", 
     RowBox[{
      RowBox[{"u", "'"}], "[", "L", "]"}]}], "==", "0"}]}], 
